<?xml version="1.0"?>
<ruleset name="Nakhostin Performance Engine">
  <description>WordPress Coding Standards for NPE.</description>
  <file>nakhostin-performance-engine.php</file>
  <file>uninstall.php</file>
  <file>src</file>
  <file>tests</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="WordPress">
    <!-- PSR-4 class names intentionally use Composer-compatible file names. -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>
  <rule ref="WordPress-Extra"/>
  <rule ref="PHPCompatibilityWP"/>
  <config name="testVersion" value="7.4-"/>
</ruleset>
