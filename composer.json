{
  "name": "nakhostin/nakhostin-performance-engine",
  "description": "A modular performance engine foundation for WordPress and WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Seyed Pedram Nakhostin"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Nakhostin\\PerformanceEngine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nakhostin\\PerformanceEngine\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "build-translations": "php tools/build-translations.php",
    "build-php-translations": "php tools/build-php-translations.php",
    "check-text": "php tools/check-text-repository.php",
    "test": "phpunit",
    "lint": "phpcs"
  }
}
